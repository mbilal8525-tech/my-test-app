<?xml version="1.0" encoding="utf-8"?>
<!-- Midnight card with a saffron tick, on a saffron background (set in ic_launcher.xml).
     Kept inside the adaptive-icon safe zone so round and squircle masks don't clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- card -->
    <path
        android:fillColor="#13233A"
        android:pathData="M35,37 L73,37 Q81,37 81,45 L81,67 Q81,75 73,75 L35,75 Q27,75 27,67 L27,45 Q27,37 35,37 Z" />
    <!-- stripe -->
    <path
        android:fillColor="#2EF7F2EA"
        android:pathData="M27,45 L81,45 L81,50.5 L27,50.5 Z" />
    <!-- tick -->
    <path
        android:strokeColor="#F2A93B"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M41,59 L50,67.5 L68,48" />
</vector>
